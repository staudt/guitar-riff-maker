{
  "name": "guitar-riff-maker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --mode lan --host --port 5190 --strictPort",
    "build": "node scripts/build-notices.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build --mode test --outDir dist-e2e && playwright test",
    "notices": "node scripts/build-notices.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "@spotify/basic-pitch": "1.0.1",
    "@tensorflow/tfjs": "3.21.0",
    "preact": "^11.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1",
  "license": "UNLICENSED"
}
